{
  "name": "tellervo-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "pnpm --filter @tellervo/app dev",
    "dev:dashboard": "pnpm --filter @tellervo/dashboard dev",
    "build": "turbo build && node scripts/copy-dist.mjs",
    "build:app": "pnpm --filter @tellervo/app build",
    "build:dashboard": "pnpm --filter @tellervo/dashboard build",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
